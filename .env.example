# ============================================
# Averixa Group
# Environment Configuration Template
# ============================================
#
# Copy this file to .env for local development.
# NEVER commit real passwords, tokens, API keys,
# private keys, or production credentials.
#

# Application
APP_NAME=Averixa Group
APP_ENV=development
APP_DEBUG=false
APP_HOST=localhost
APP_PORT=8000

# Public URLs
APP_URL=http://localhost:8000
API_URL=http://localhost:8000/api

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Cache / Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Averixa Group

# External services
EXTERNAL_API_URL=
EXTERNAL_API_KEY=

# Security
APP_SECRET_KEY=
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO

# ============================================
# Add project-specific variables below.
# Never place real credentials in this file.
# ============================================
